        </mxCell>
        <mxCell id="7ofp-HEbSBJugO21LCpp-30" value="A logical object within an account used to organize your data.&amp;nbsp;&lt;div&gt;A database can hold multiple schemas&amp;nbsp;&lt;/div&gt;&lt;div&gt;and is designed to group related data by subject, department, or function.&lt;/div&gt;" style="text;html=1;align=left;verticalAlign=middle;resizable=0;points=[];autosize=1;strokeColor=none;fillColor=none;fontSize=13;" parent="7ofp-HEbSBJugO21LCpp-1" vertex="1">
          <mxGeometry x="395" y="130" width="440" height="60" as="geometry" />
        </mxCell>
        <mxCell id="7ofp-HEbSBJugO21LCpp-31" value="An object within a database that holds tables, views, stages, file formats,&amp;nbsp;&lt;div&gt;sequences, stored procedures, user-defined functions, and other objects.&amp;nbsp;&lt;/div&gt;&lt;div&gt;Schemas help organize data within a database by grouping related objects.&lt;/div&gt;" style="text;html=1;align=left;verticalAlign=middle;resizable=0;points=[];autosize=1;strokeColor=none;fillColor=none;fontSize=13;" parent="7ofp-HEbSBJugO21LCpp-1" vertex="1">
          <mxGeometry x="395" y="200" width="460" height="60" as="geometry" />
        </mxCell>
        <mxCell id="7ofp-HEbSBJugO21LCpp-32" value="An object for storing structured (with rows and columns)&amp;nbsp;&lt;div&gt;and semi-structured data.&lt;/div&gt;" style="text;html=1;align=left;verticalAlign=middle;resizable=0;points=[];autosize=1;strokeColor=none;fillColor=none;fontSize=13;" parent="7ofp-HEbSBJugO21LCpp-1" vertex="1">
          <mxGeometry x="395" y="280" width="350" height="40" as="geometry" />
        </mxCell>
        <mxCell id="7ofp-HEbSBJugO21LCpp-33" value="A view allows the result of a query to be accessed as if it were a table" style="text;html=1;align=left;verticalAlign=middle;resizable=0;points=[];autosize=1;strokeColor=none;fillColor=none;fontSize=13;" parent="7ofp-HEbSBJugO21LCpp-1" vertex="1">
          <mxGeometry x="395" y="495" width="420" height="30" as="geometry" />
        </mxCell>
        <mxCell id="7ofp-HEbSBJugO21LCpp-34" value="A storage location used for loading or unloading data files.&amp;nbsp;&lt;div&gt;Stages can be internal (within Snowflake) or&amp;nbsp;&lt;/div&gt;&lt;div&gt;external (such as on AWS S3, Azure Blob Storage, or Google Cloud Storage)&lt;/div&gt;" style="text;html=1;align=left;verticalAlign=middle;resizable=0;points=[];autosize=1;strokeColor=none;fillColor=none;fontSize=13;" parent="7ofp-HEbSBJugO21LCpp-1" vertex="1">
          <mxGeometry x="395" y="667" width="470" height="60" as="geometry" />
        </mxCell>
        <mxCell id="7ofp-HEbSBJugO21LCpp-35" value="&lt;font style=&quot;font-size: 14px;&quot;&gt;Materialized View&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;" parent="7ofp-HEbSBJugO21LCpp-1" vertex="1">
          <mxGeometry x="380" y="550" width="140" height="40" as="geometry" />
        </mxCell>
        <mxCell id="7ofp-HEbSBJugO21LCpp-36" value="&lt;font style=&quot;font-size: 14px;&quot;&gt;Secure View&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;" parent="7ofp-HEbSBJugO21LCpp-1" vertex="1">
          <mxGeometry x="380" y="610" width="140" height="40" as="geometry" />
        </mxCell>
        <mxCell id="7ofp-HEbSBJugO21LCpp-37" value="In materialized view data is pre-computed,&amp;nbsp;&lt;div&gt;querying a materialized view is faster&amp;nbsp;&lt;/div&gt;&lt;div&gt;than executing a query against the base table of the view.&lt;/div&gt;" style="text;html=1;align=left;verticalAlign=middle;resizable=0;points=[];autosize=1;strokeColor=none;fillColor=none;fontSize=13;" parent="7ofp-HEbSBJugO21LCpp-1" vertex="1">
          <mxGeometry x="530" y="540" width="350" height="60" as="geometry" />
        </mxCell>
        <mxCell id="7ofp-HEbSBJugO21LCpp-38" value="&lt;font style=&quot;font-size: 13px;&quot;&gt;Secure Views are specifically designated for data privacy to limit access to sensitive data that should not be exposed to all users of the underlying table(s)&lt;/font&gt;" style="text;html=1;align=left;verticalAlign=middle;whiteSpace=wrap;rounded=0;" parent="7ofp-HEbSBJugO21LCpp-1" vertex="1">
