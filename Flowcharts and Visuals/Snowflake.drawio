        <mxCell id="Uu89i2RjmzTx0yzUMjrT-2" value="&lt;h1 style=&quot;margin-top: 0px;&quot;&gt;&lt;font style=&quot;font-size: 13px; color: rgb(153, 76, 0);&quot;&gt;3. Cortex AI&lt;/font&gt;&lt;/h1&gt;&lt;p&gt;&lt;/p&gt;&lt;ul&gt;&lt;li&gt;&lt;font style=&quot;font-size: 10px;&quot;&gt;Cortex AI, is a suit of AI Features that use Large Language models to understand unstructured data and answer free form questions on data&lt;/font&gt;&lt;/li&gt;&lt;li&gt;&lt;font style=&quot;font-size: 10px;&quot;&gt;Allows multiple users to build AI Models with No-Code, SQL and Python interfaces&lt;/font&gt;&lt;/li&gt;&lt;/ul&gt;&lt;p&gt;&lt;/p&gt;" style="text;html=1;whiteSpace=wrap;overflow=hidden;rounded=0;" vertex="1" parent="Uu89i2RjmzTx0yzUMjrT-8">
