        </mxCell>
        <mxCell id="YzH1Is9NxmRi8i4xoFUJ-42" value="&lt;font style=&quot;font-size: 13px;&quot;&gt;Temporary data tied to a single session&lt;/font&gt;" style="text;html=1;align=left;verticalAlign=middle;whiteSpace=wrap;rounded=0;" parent="1" vertex="1">
