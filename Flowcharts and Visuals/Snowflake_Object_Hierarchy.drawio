          <mxGeometry x="380" y="760" width="140" height="30" as="geometry" />
        </mxCell>
        <mxCell id="YzH1Is9NxmRi8i4xoFUJ-47" value="&lt;font style=&quot;font-size: 14px;&quot;&gt;External&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;" parent="1" vertex="1">
          <mxGeometry x="380" y="802.5" width="140" height="30" as="geometry" />
        </mxCell>
        <mxCell id="YzH1Is9NxmRi8i4xoFUJ-48" value="Created by users and points to a cloud repository&amp;nbsp;&lt;div&gt;within the Snowflake&#39;s ecosystem.&lt;/div&gt;" style="text;html=1;align=left;verticalAlign=middle;resizable=0;points=[];autosize=1;strokeColor=none;fillColor=none;fontSize=13;" parent="1" vertex="1">
          <mxGeometry x="530" y="755" width="310" height="40" as="geometry" />
        </mxCell>
        <mxCell id="YzH1Is9NxmRi8i4xoFUJ-49" value="&lt;span style=&quot;font-size: 13px; text-wrap-mode: nowrap;&quot;&gt;Created by users and points to a cloud repository&amp;nbsp;&lt;/span&gt;&lt;div style=&quot;font-size: 13px; text-wrap-mode: nowrap;&quot;&gt;outside the Snowflake&#39;s ecosystem.&lt;/div&gt;" style="text;html=1;align=left;verticalAlign=middle;whiteSpace=wrap;rounded=0;" parent="1" vertex="1">
          <mxGeometry x="530" y="800" width="330" height="35" as="geometry" />
