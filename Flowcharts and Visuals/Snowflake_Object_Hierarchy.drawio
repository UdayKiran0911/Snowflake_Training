        </mxCell>
        <mxCell id="YzH1Is9NxmRi8i4xoFUJ-39" value="Long-term storage" style="text;html=1;align=left;verticalAlign=middle;resizable=0;points=[];autosize=1;strokeColor=none;fillColor=none;fontSize=13;" parent="1" vertex="1">
          <mxGeometry x="530" y="355" width="130" height="30" as="geometry" />
        </mxCell>
